# Sao chép file này thành .env.local rồi điền giá trị thật từ dự án Supabase của bạn
# (Project Settings > API trên supabase.com, hoặc `supabase status` nếu chạy local).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# CHỈ dùng ở server (API routes / scripts), KHÔNG bao giờ lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (VAPID) — sinh bằng: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@huugiaphat.vn

# Bí mật để bảo vệ endpoint cron kiểm tra thông báo định kỳ
# (api/notifications/check) — đặt 1 chuỗi ngẫu nhiên bất kỳ.
CRON_SECRET=
